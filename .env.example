# Copy to .env; this file is ignored by Git. No access keys belong here.
AWS_PROFILE=your-sso-profile
EXPECTED_ACCOUNT_ID=123456789012
AWS_REGION=ap-northeast-1
# Lowercase letters/digits, 6-12 characters. Choose a new value for each lab.
LAB_ID=example01
# Your current public IPv4 address plus /32. Only this CIDR can reach the API.
ADMIN_CIDR=203.0.113.10/32
